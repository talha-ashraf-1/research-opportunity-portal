      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Status is Closed\", () => pm.expect(pm.response.json().data.status).to.eql(\"Closed\"));"
            ]
          }
        }
      ]
