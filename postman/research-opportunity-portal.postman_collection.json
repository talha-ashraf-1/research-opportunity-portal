{
  "info": {
    "name": "Research Opportunity Portal API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run requests in order (1a to 8). Ids are saved automatically between requests. Deadlines must not be in the past when creating."
  },
  "item": [
    {
      "name": "1a. Create opportunity #1",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/opportunities",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "opportunities"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Deep Learning for Medical Imaging\",\n  \"description\": \"Research on CNN models for early disease detection in X-ray images.\",\n  \"researchArea\": \"Artificial Intelligence\",\n  \"facultyName\": \"Dr. Ayesha Khan\",\n  \"department\": \"Computer Science\",\n  \"requiredSkills\": \"Python, PyTorch, Computer Vision\",\n  \"positions\": 2,\n  \"deadline\": \"2026-12-31\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
              "const id = pm.response.json().data.id;",
              "pm.collectionVariables.set(\"id1\", id);"
            ]
          }
        }
      ]
    },
